# Copy to .env and fill in. Both values are optional for local development.

# Absolute public URL of the deployed site, without a trailing slash.
# Used for Open Graph / Twitter preview URLs in index.html, e.g. https://yourname.dev
VITE_SITE_URL=

# Optional: endpoint of a form service (e.g. Formspree, Basin, Getform) that accepts
# JSON POST requests. When empty, the contact form falls back to opening the
# visitor's email app with a pre-filled message (mailto).
VITE_FORM_ENDPOINT=
